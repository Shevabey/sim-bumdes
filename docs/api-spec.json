{
  "openapi": "3.0.3",
  "info": {
    "title": "SIM-BUMDes API",
    "version": "1.0.0",
    "description": "API internal untuk Sistem Informasi Manajemen BUMDes Terintegrasi. Dikonsumsi oleh portal Pengguna (Livewire) dan dapat dipakai sebagai acuan struktur data untuk panel Filament (Filament tidak wajib memakai REST API ini secara langsung karena berjalan di proses yang sama, tapi kontrak data/aturan bisnis di sini tetap berlaku sebagai source of truth)."
  },
  "servers": [
    { "url": "http://localhost:8000/api/v1", "description": "Local development (Docker)" }
  ],
  "components": {
    "securitySchemes": {
      "sessionAuth": { "type": "apiKey", "in": "cookie", "name": "sim_bumdes_session", "description": "Laravel session-based auth (Sanctum SPA-style) untuk portal pengguna" }
    },
    "schemas": {
      "Region": {
        "type": "object",
        "properties": {
          "id_region": { "type": "string", "example": "REG-3404-070-005" },
          "level": { "type": "string", "enum": ["provinsi", "kota", "kecamatan", "kelurahan"] },
          "parent_id": { "type": "string", "nullable": true },
          "nama": { "type": "string" },
          "is_koordinator": { "type": "boolean" }
        },
        "required": ["level", "nama"]
      },
      "BUMDes": {
        "type": "object",
        "properties": {
          "id_bumdes": { "type": "string", "example": "BMD-SDS-001" },
          "id_kelurahan": { "type": "string" },
          "nama_bumdes": { "type": "string" },
          "status_aktif": { "type": "boolean" },
          "tanggal_berdiri": { "type": "string", "format": "date" }
        },
        "required": ["id_kelurahan", "nama_bumdes"]
      },
      "UnitUsaha": {
        "type": "object",
        "properties": {
          "id_unit": { "type": "string", "example": "UNT-SDS-PAM-01" },
          "id_bumdes": { "type": "string" },
          "jenis_unit": { "type": "string", "enum": ["pamdes", "peternakan", "mitra_tani", "sewa_mobil", "sampah", "custom"] },
          "nama_unit": { "type": "string" },
          "skema_field": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string", "enum": ["number", "currency", "text", "date"] }
              }
            }
          },
          "status_aktif": { "type": "boolean" }
        },
        "required": ["id_bumdes", "jenis_unit", "nama_unit"]
      },
      "Transaksi": {
        "type": "object",
        "properties": {
          "id_transaksi": { "type": "string", "example": "TRX-20260916-000345" },
          "id_unit": { "type": "string" },
          "tipe": { "type": "string", "enum": ["input", "output"] },
          "jumlah": { "type": "number", "format": "float" },
          "detail": { "type": "object", "additionalProperties": true },
          "tanggal": { "type": "string", "format": "date" },
          "dicatat_oleh": { "type": "string" }
        },
        "required": ["id_unit", "tipe", "jumlah", "tanggal"]
      },
      "Pelanggan": {
        "type": "object",
        "properties": {
          "id_pelanggan": { "type": "string", "example": "PLG-SDS-PAM-0045" },
          "id_unit": { "type": "string" },
          "nama": { "type": "string" },
          "kontak": { "type": "string" },
          "id_akun": { "type": "string", "nullable": true },
          "status_aktif": { "type": "boolean" }
        },
        "required": ["id_unit", "nama"]
      },
      "Tagihan": {
        "type": "object",
        "properties": {
          "id_tagihan": { "type": "string", "example": "TAG-20260916-000112" },
          "id_pelanggan": { "type": "string" },
          "id_unit": { "type": "string" },
          "jumlah": { "type": "number" },
          "jatuh_tempo": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["belum_bayar", "menunggu_verifikasi", "lunas", "ditolak"] },
          "metode": { "type": "string", "enum": ["tunai", "transfer"], "nullable": true },
          "bukti_transfer_url": { "type": "string", "nullable": true },
          "diverifikasi_oleh": { "type": "string", "nullable": true },
          "tanggal_verifikasi": { "type": "string", "format": "date-time", "nullable": true }
        },
        "required": ["id_pelanggan", "id_unit", "jumlah", "jatuh_tempo"]
      },
      "IuranBUMDes": {
        "type": "object",
        "properties": {
          "id_iuran": { "type": "string", "example": "IUR-BMD-SDS-001-2026-09" },
          "id_bumdes": { "type": "string" },
          "bulan_tahun": { "type": "string", "example": "2026-09" },
          "jumlah": { "type": "number", "default": 50000 },
          "status": { "type": "string", "enum": ["belum_bayar", "lunas"] },
          "sumber_dana": { "type": "string", "enum": ["kas", "luar_kas"], "nullable": true },
          "tanggal_bayar": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Referral": {
        "type": "object",
        "properties": {
          "id_referral": { "type": "string", "example": "REF-BMD-SDS-001-A1B2C3" },
          "id_bumdes_pengaju": { "type": "string" },
          "id_bumdes_penerima": { "type": "string", "nullable": true },
          "kode_unik": { "type": "string" },
          "tanggal_generate": { "type": "string", "format": "date-time" },
          "tanggal_expired": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["aktif", "terpakai", "kedaluwarsa", "pending", "cair", "gagal"] },
          "tanggal_redeem": { "type": "string", "format": "date-time", "nullable": true },
          "batas_verifikasi": { "type": "string", "format": "date-time", "nullable": true },
          "tanggal_cair": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Akun": {
        "type": "object",
        "properties": {
          "id_akun": { "type": "string", "example": "AKN-000123" },
          "nama": { "type": "string" },
          "username": { "type": "string" },
          "role": { "type": "string", "enum": ["super_admin", "pengawas", "penasihat", "direktur", "admin_bumdes", "sekretaris", "bendahara", "admin_unit", "pengguna"] },
          "id_bumdes": { "type": "string", "nullable": true },
          "id_unit": { "type": "string", "nullable": true },
          "status_aktif": { "type": "boolean" }
        },
        "required": ["nama", "username", "role"]
      },
      "Feedback": {
        "type": "object",
        "properties": {
          "id_feedback": { "type": "string", "example": "FB-000078" },
          "dari_id_akun": { "type": "string" },
          "ke_id_bumdes": { "type": "string" },
          "ke_id_unit": { "type": "string", "nullable": true },
          "isi_catatan": { "type": "string" },
          "status_tindak_lanjut": { "type": "string", "enum": ["belum", "sedang", "selesai"] },
          "tanggal": { "type": "string", "format": "date-time" }
        },
        "required": ["ke_id_bumdes", "isi_catatan"]
      },
      "LogAktivitas": {
        "type": "object",
        "properties": {
          "id_log": { "type": "integer" },
          "id_akun": { "type": "string" },
          "modul": { "type": "string" },
          "aksi": { "type": "string" },
          "detail": { "type": "object", "additionalProperties": true },
          "waktu": { "type": "string", "format": "date-time" },
          "ip_address": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "errors": { "type": "object", "additionalProperties": true }
        }
      }
    }
  },
  "security": [{ "sessionAuth": [] }],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login akun (semua role)",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "username": { "type": "string" }, "password": { "type": "string" } }, "required": ["username", "password"] } } } },
        "responses": { "200": { "description": "Login berhasil", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Akun" } } } }, "401": { "description": "Kredensial salah" } }
      }
    },
    "/auth/logout": { "post": { "tags": ["Auth"], "summary": "Logout", "responses": { "204": { "description": "Berhasil logout" } } } },

    "/regions": {
      "get": { "tags": ["Region"], "summary": "List region (filter by level/parent)", "parameters": [ { "name": "level", "in": "query", "schema": { "type": "string" } }, { "name": "parent_id", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Region" } } } } } } },
      "post": { "tags": ["Region"], "summary": "Tambah region (Super Admin)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Region" } } } }, "responses": { "201": { "description": "Created" }, "403": { "description": "Forbidden - role tidak berwenang" } } }
    },
    "/regions/{id}": {
      "put": { "tags": ["Region"], "summary": "Update region (Super Admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Region"], "summary": "Hapus region (Super Admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" } } }
    },

    "/bumdes": {
      "get": { "tags": ["BUMDes"], "summary": "List BUMDes (scope sesuai role)", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/BUMDes" } } } } } } },
      "post": { "tags": ["BUMDes"], "summary": "Tambah BUMDes (Super Admin)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BUMDes" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/bumdes/{id}": {
      "get": { "tags": ["BUMDes"], "summary": "Detail BUMDes", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BUMDes" } } } } } },
      "put": { "tags": ["BUMDes"], "summary": "Update data BUMDes (Admin BUMDes/Super Admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Updated" } } }
    },
    "/bumdes/{id}/toggle-status": {
      "patch": { "tags": ["BUMDes"], "summary": "Aktif/nonaktifkan BUMDes (FR-08, khusus Super Admin)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "status_aktif": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "Status diperbarui" }, "403": { "description": "Hanya Super Admin" } } }
    },

    "/units": {
      "get": { "tags": ["Unit Usaha"], "summary": "List unit usaha (filter id_bumdes)", "parameters": [{ "name": "id_bumdes", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UnitUsaha" } } } } } } },
      "post": { "tags": ["Unit Usaha"], "summary": "Tambah unit usaha (Admin BUMDes/Sekretaris, FR-05)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnitUsaha" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/units/{id}/toggle-status": {
      "patch": { "tags": ["Unit Usaha"], "summary": "Aktif/nonaktifkan unit (FR-09, khusus Admin BUMDes)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Status diperbarui" } } }
    },

    "/customers": {
      "get": { "tags": ["Pelanggan"], "summary": "List pelanggan per unit", "parameters": [{ "name": "id_unit", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Pelanggan" } } } } } } },
      "post": { "tags": ["Pelanggan"], "summary": "Tambah pelanggan (Admin Unit/Sekretaris)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pelanggan" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/customers/{id}/toggle-status": {
      "patch": { "tags": ["Pelanggan"], "summary": "Aktif/nonaktifkan pelanggan (FR-10, khusus Admin Unit)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Status diperbarui" } } }
    },

    "/transactions": {
      "get": { "tags": ["Transaksi"], "summary": "List transaksi per unit dengan filter tanggal", "parameters": [ { "name": "id_unit", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "dari_tanggal", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "sampai_tanggal", "in": "query", "schema": { "type": "string", "format": "date" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Transaksi" } } } } } } },
      "post": { "tags": ["Transaksi"], "summary": "Catat transaksi baru (Admin Unit/Bendahara, FR-07)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Transaksi" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/units/{id}/summary": {
      "get": { "tags": ["Transaksi"], "summary": "Ringkasan untung-rugi unit (agregat)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "total_input": { "type": "number" }, "total_output": { "type": "number" }, "untung_rugi": { "type": "number" } } } } } } } }
    },

    "/bills": {
      "get": { "tags": ["Tagihan"], "summary": "List tagihan (filter id_pelanggan/id_unit/status)", "parameters": [ { "name": "id_pelanggan", "in": "query", "schema": { "type": "string" } }, { "name": "id_unit", "in": "query", "schema": { "type": "string" } }, { "name": "status", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Tagihan" } } } } } } },
      "post": { "tags": ["Tagihan"], "summary": "Buat tagihan baru (Admin Unit/Sekretaris, FR-11)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tagihan" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/bills/{id}/pay-cash": {
      "post": { "tags": ["Tagihan"], "summary": "Catat pembayaran tunai (Admin Unit/Sekretaris/Bendahara, FR-15)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Status menjadi lunas" } } }
    },
    "/bills/{id}/upload-proof": {
      "post": { "tags": ["Tagihan"], "summary": "Upload bukti transfer (Pengguna/Pelanggan, FR-13)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } } } } } }, "responses": { "200": { "description": "Status menjadi menunggu_verifikasi" } } }
    },
    "/bills/{id}/verify": {
      "post": { "tags": ["Tagihan"], "summary": "Verifikasi/tolak bukti transfer (Admin Unit, FR-14)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "approve": { "type": "boolean" }, "catatan": { "type": "string" } } } } } }, "responses": { "200": { "description": "Status menjadi lunas atau ditolak" } } }
    },

    "/dues": {
      "get": { "tags": ["Iuran"], "summary": "List iuran per BUMDes/bulan", "parameters": [{ "name": "id_bumdes", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/IuranBUMDes" } } } } } } }
    },
    "/dues/{id}/pay": {
      "post": { "tags": ["Iuran"], "summary": "Bayar iuran dari kas/luar kas (Bendahara, FR-17)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "sumber_dana": { "type": "string", "enum": ["kas", "luar_kas"] } } } } } }, "responses": { "200": { "description": "Menunggu verifikasi koordinator" } } }
    },
    "/dues/{id}/verify": {
      "post": { "tags": ["Iuran"], "summary": "Verifikasi iuran oleh koordinator kecamatan (Admin BUMDes Sendangsari)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Status menjadi lunas" } } }
    },

    "/referrals/generate": {
      "post": { "tags": ["Referral"], "summary": "Generate/lihat kode referral aktif milik BUMDes (Admin BUMDes, FR-18)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "id_bumdes_pengaju": { "type": "string" } } } } } }, "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Referral" } } } } } }
    },
    "/referrals/redeem": {
      "post": { "tags": ["Referral"], "summary": "Redeem kode referral (Admin BUMDes penerima, FR-20)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "kode_unik": { "type": "string" }, "id_bumdes_penerima": { "type": "string" } }, "required": ["kode_unik", "id_bumdes_penerima"] } } } }, "responses": { "200": { "description": "Redeem berhasil, status referral menjadi pending" }, "422": { "description": "Kode tidak valid/kedaluwarsa/sudah dipakai", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } } }
    },
    "/referrals": {
      "get": { "tags": ["Referral"], "summary": "Riwayat referral per BUMDes", "parameters": [{ "name": "id_bumdes", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Referral" } } } } } } }
    },

    "/accounts": {
      "get": { "tags": ["Akun"], "summary": "List akun (scope sesuai role pemanggil)", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Akun" } } } } } } },
      "post": { "tags": ["Akun"], "summary": "Buat akun baru (Super Admin/Admin BUMDes sesuai kewenangan, FR-24/FR-25)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Akun" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/accounts/{id}/toggle-status": {
      "patch": { "tags": ["Akun"], "summary": "Aktif/nonaktifkan akun", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Status diperbarui" } } }
    },
    "/accounts/{id}/activity-log": {
      "get": { "tags": ["Akun"], "summary": "Log aktivitas per akun (Super Admin, FR-32)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/LogAktivitas" } } } } } } }
    },

    "/feedback": {
      "get": { "tags": ["Feedback"], "summary": "List catatan/feedback (filter id_bumdes/id_unit)", "parameters": [ { "name": "id_bumdes", "in": "query", "schema": { "type": "string" } }, { "name": "id_unit", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Feedback" } } } } } } },
      "post": { "tags": ["Feedback"], "summary": "Kirim catatan/feedback (Pengawas/Penasihat/Direktur/Super Admin, FR-33)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Feedback" } } } }, "responses": { "201": { "description": "Created, notifikasi real-time dikirim (FR-34)" } } }
    },
    "/feedback/{id}/status": {
      "patch": { "tags": ["Feedback"], "summary": "Update status tindak lanjut (Pengurus BUMDes, FR-35)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "status_tindak_lanjut": { "type": "string", "enum": ["belum", "sedang", "selesai"] } } } } } }, "responses": { "200": { "description": "Updated" } } }
    },

    "/reports/unit/{id}/export": {
      "get": { "tags": ["Laporan"], "summary": "Ekspor laporan transaksi unit ke Excel (FR-28)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "File Excel (.xlsx)", "content": { "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {} } } } }
    },
    "/reports/bumdes/{id}/export": {
      "get": { "tags": ["Laporan"], "summary": "Ekspor laporan gabungan BUMDes ke Excel (FR-28)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "File Excel (.xlsx)" } } }
